rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserData().role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getRole() == 'super_admin';
    }

    function isOwnerOf(shopId) {
      return isAuthenticated() && getUserData().shopId == shopId && getRole() == 'owner';
    }

    function isManagerOf(shopId) {
      return isAuthenticated() && getUserData().shopId == shopId && getRole() == 'manager';
    }

    function isAdminOf(shopId) {
      // owner hoặc manager trong cùng shop
      return isOwnerOf(shopId) || isManagerOf(shopId);
    }

    function isStaffOf(shopId) {
      return isAuthenticated() && getUserData().shopId == shopId && getRole() == 'staff';
    }

    function isMemberOf(shopId) {
      return isAuthenticated() && getUserData().shopId == shopId;
    }

    // ── shops ───────────────────────────────────────────────
    match /shops/{shopId} {
      allow read:             if isSuperAdmin() || isMemberOf(shopId);
      allow create:           if isSuperAdmin();
      allow update:           if isSuperAdmin() || isOwnerOf(shopId);
      allow delete:           if isSuperAdmin() || isOwnerOf(shopId);
    }

    // ── users ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSuperAdmin()
                  || (isAuthenticated() && request.auth.uid == userId)
                  || isMemberOf(resource.data.shopId);

      // Không ai tự tạo hồ sơ cho mình: owner tạo manager/staff, manager tạo staff, trong tiệm của họ.
      allow create: if isSuperAdmin()
                    || (isOwnerOf(request.resource.data.shopId)
                        && request.resource.data.role in ['manager', 'staff'])
                    || (isManagerOf(request.resource.data.shopId)
                        && request.resource.data.role == 'staff');

      // Chỉ super_admin hoặc owner mới sửa được manager/owner khác.
      // Manager chỉ sửa được chính mình và staff — không sửa owner/manager khác.
      // Chỉ super_admin đổi được tiệm; không ai tự đổi role, shopId hay active của mình.
      allow update: if isSuperAdmin()
                    || (isAuthenticated() && request.auth.uid == userId   // tự sửa bản thân
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name', 'phone', 'photoURL', 'encryptedPassword']))
                    || (isOwnerOf(resource.data.shopId)                   // owner sửa ai cũng được trừ super_admin
                        && resource.data.role != 'super_admin'
                        && request.resource.data.shopId == resource.data.shopId
                        && (request.resource.data.role == resource.data.role
                            || request.resource.data.role in ['manager', 'staff']))
                    || (isManagerOf(resource.data.shopId)                 // manager chỉ sửa staff
                        && resource.data.role == 'staff'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name', 'phone', 'photoURL', 'encryptedPassword', 'active']));

      allow delete: if isSuperAdmin()
                    || isOwnerOf(resource.data.shopId);
    }

    // ── services ────────────────────────────────────────────
    match /services/{serviceId} {
      allow read:   if isSuperAdmin() || isMemberOf(resource.data.shopId);
      allow create: if isSuperAdmin() || isAdminOf(request.resource.data.shopId);
      allow update,
            delete: if isSuperAdmin() || isAdminOf(resource.data.shopId);
    }

    // ── transactions ────────────────────────────────────────
    match /transactions/{transactionId} {
      allow read:   if isSuperAdmin() || isMemberOf(resource.data.shopId);
      allow create: if isSuperAdmin() || isMemberOf(request.resource.data.shopId);
      allow update: if isSuperAdmin()
                    || isAdminOf(resource.data.shopId)
                    || (isStaffOf(resource.data.shopId)
                        && resource.data.staffId == request.auth.uid);
      allow delete: if isSuperAdmin() || isAdminOf(resource.data.shopId);
    }

    // ── lịch sử xóa doanh thu ───────────────────────────────
    // Chỉ super_admin. Update chỉ để cộng dồn số liệu khi xóa nhiều lô; không ai xóa được lịch sử.
    match /revenueDeletionLogs/{logId} {
      allow read:   if isSuperAdmin();
      allow create: if isSuperAdmin() && request.resource.data.deletedBy == request.auth.uid;
      allow update: if isSuperAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['transactionCount', 'totalAmount']);
    }
  }
}
